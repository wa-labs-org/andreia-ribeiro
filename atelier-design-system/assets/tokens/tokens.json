{
  "$description": "Alinhavo — Design System do Atelier. Formato W3C Design Tokens (DTCG). Espelho de tokens.css.",
  "color": {
    "marca": {
      "marfim": {
        "$type": "color",
        "$value": "#FDF7E7",
        "$description": "Creme marfim · fundo da página; texto sobre café (11.67:1)."
      },
      "manteiga": {
        "$type": "color",
        "$value": "#F9F1D8",
        "$description": "Creme manteiga · fundo 2: seções alternadas, cards, formulário, rodapé."
      },
      "rose": {
        "$type": "color",
        "$value": "#F3DFD2",
        "$description": "Rosé blush · detalhe: passe-partout de imagem, porta Seda."
      },
      "dourado-claro": {
        "$type": "color",
        "$value": "#C6AF6C",
        "$description": "Dourado claro · brilho. Sobre café: texto secundário, link, foco (5.79:1). Nunca texto sobre creme."
      },
      "dourado": {
        "$type": "color",
        "$value": "#B99847",
        "$description": "Dourado principal · marca: monograma, costuras, fita, hover do botão (café sobre ele 4.54:1). Nunca texto sobre creme."
      },
      "dourado-antigo": {
        "$type": "color",
        "$value": "#B19F6E",
        "$description": "Dourado antigo · traços: divisórias, linhas de construção. Nunca texto (2.44:1)."
      },
      "bronze": {
        "$type": "color",
        "$value": "#7A6230",
        "$description": "Bronze · texto secundário, links, foco, borda de campo, sucesso (5.43:1)."
      },
      "cafe": {
        "$type": "color",
        "$value": "#3D3226",
        "$description": "Café · texto principal, botão primário, fundo do registro Casimira (11.67:1)."
      }
    },
    "funcional": {
      "erro": {
        "$type": "color",
        "$value": "#9A3B2E",
        "$description": "Terracota, fora da paleta de marca · só mensagens de erro, sempre com ícone (6.46:1)."
      }
    },
    "veu": {
      "tule": {
        "$type": "color",
        "$value": "#FDF7E7B8",
        "$description": "Marfim a 72% + blur 14px."
      },
      "tule-noite": {
        "$type": "color",
        "$value": "#3D3226B8",
        "$description": "Café a 72%."
      },
      "sombra": {
        "$type": "color",
        "$value": "#3D322647",
        "$description": "Café a 28%."
      }
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Fraunces",
          "Iowan Old Style",
          "Georgia",
          "serif"
        ]
      },
      "text": {
        "$type": "fontFamily",
        "$value": [
          "Instrument Sans",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ]
      },
      "note": {
        "$type": "fontFamily",
        "$value": [
          "IBM Plex Mono",
          "ui-monospace",
          "monospace"
        ]
      }
    },
    "axis": {
      "soft-seda": {
        "$type": "number",
        "$value": 100,
        "$description": "Fraunces SOFT no registro Seda."
      },
      "soft-casimira": {
        "$type": "number",
        "$value": 0,
        "$description": "Fraunces SOFT no registro Casimira."
      }
    }
  },
  "typography": {
    "display-xl": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontWeight": 300,
        "fontSize": "clamp(3.25rem, 1.6rem + 8.4vw, 10.5rem)",
        "lineHeight": 0.92,
        "letterSpacing": "-0.022em"
      }
    },
    "display-l": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontWeight": 300,
        "fontSize": "clamp(2.75rem, 1.5rem + 5.6vw, 6.75rem)",
        "lineHeight": 0.92,
        "letterSpacing": "-0.022em"
      }
    },
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontWeight": 350,
        "fontSize": "clamp(2.25rem, 1.45rem + 3.6vw, 4.5rem)",
        "lineHeight": 1.04,
        "letterSpacing": "-0.012em"
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontWeight": 350,
        "fontSize": "clamp(1.875rem, 1.3rem + 2.4vw, 3.25rem)",
        "lineHeight": 1.04,
        "letterSpacing": "-0.012em"
      }
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontWeight": 400,
        "fontSize": "clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem)",
        "lineHeight": 1.25,
        "letterSpacing": "-0.012em"
      }
    },
    "h4": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontWeight": 400,
        "fontSize": "clamp(1.25rem, 1.15rem + 0.4vw, 1.5rem)",
        "lineHeight": 1.25,
        "letterSpacing": "0"
      }
    },
    "lead": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontWeight": 300,
        "fontSize": "clamp(1.25rem, 1.1rem + 0.7vw, 1.75rem)",
        "lineHeight": 1.4,
        "letterSpacing": "0"
      }
    },
    "body-l": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontWeight": 400,
        "fontSize": "1.125rem",
        "lineHeight": 1.62,
        "letterSpacing": "0"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontWeight": 400,
        "fontSize": "1rem",
        "lineHeight": 1.62,
        "letterSpacing": "0"
      }
    },
    "body-s": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontWeight": 400,
        "fontSize": "0.875rem",
        "lineHeight": 1.55,
        "letterSpacing": "0"
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontWeight": 600,
        "fontSize": "0.75rem",
        "lineHeight": 1.2,
        "letterSpacing": "0.16em",
        "fontStretch": "80%",
        "textTransform": "uppercase"
      }
    },
    "button": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontWeight": 600,
        "fontSize": "0.8125rem",
        "lineHeight": 1,
        "letterSpacing": "0.12em",
        "fontStretch": "85%",
        "textTransform": "uppercase"
      }
    },
    "note": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.note}",
        "fontWeight": 400,
        "fontSize": "0.6875rem",
        "lineHeight": 1.5,
        "letterSpacing": "0.04em",
        "textTransform": "uppercase"
      }
    }
  },
  "space": {
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "5": {
      "$type": "dimension",
      "$value": "24px"
    },
    "6": {
      "$type": "dimension",
      "$value": "32px"
    },
    "7": {
      "$type": "dimension",
      "$value": "48px"
    },
    "8": {
      "$type": "dimension",
      "$value": "64px"
    },
    "9": {
      "$type": "dimension",
      "$value": "96px"
    },
    "10": {
      "$type": "dimension",
      "$value": "128px"
    },
    "11": {
      "$type": "dimension",
      "$value": "192px"
    },
    "section-y": {
      "$type": "dimension",
      "$value": "clamp(6rem, 3rem + 11vw, 14rem)"
    },
    "section-y-s": {
      "$type": "dimension",
      "$value": "clamp(4rem, 2.5rem + 6vw, 8rem)"
    }
  },
  "grid": {
    "base": {
      "breakpoint": {
        "$type": "dimension",
        "$value": "0px"
      },
      "cols": {
        "$type": "number",
        "$value": 4
      },
      "gutter": {
        "$type": "dimension",
        "$value": "16px"
      },
      "margin": {
        "$type": "dimension",
        "$value": "20px"
      }
    },
    "md": {
      "breakpoint": {
        "$type": "dimension",
        "$value": "768px"
      },
      "cols": {
        "$type": "number",
        "$value": 8
      },
      "gutter": {
        "$type": "dimension",
        "$value": "20px"
      },
      "margin": {
        "$type": "dimension",
        "$value": "32px"
      }
    },
    "lg": {
      "breakpoint": {
        "$type": "dimension",
        "$value": "1024px"
      },
      "cols": {
        "$type": "number",
        "$value": 12
      },
      "gutter": {
        "$type": "dimension",
        "$value": "24px"
      },
      "margin": {
        "$type": "dimension",
        "$value": "48px"
      }
    },
    "xl": {
      "breakpoint": {
        "$type": "dimension",
        "$value": "1440px"
      },
      "cols": {
        "$type": "number",
        "$value": 12
      },
      "gutter": {
        "$type": "dimension",
        "$value": "24px"
      },
      "margin": {
        "$type": "dimension",
        "$value": "64px"
      }
    },
    "max": {
      "$type": "dimension",
      "$value": "1600px"
    }
  },
  "radius": {
    "corte": {
      "$type": "dimension",
      "$value": "0px"
    },
    "campo": {
      "$type": "dimension",
      "$value": "2px"
    },
    "botao": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "stitch": {
    "corrido": {
      "$type": "strokeStyle",
      "$value": {
        "dashArray": [
          "6px",
          "5px"
        ],
        "lineCap": "butt"
      },
      "$description": "Ponto corrido: divisórias."
    },
    "alinhavo": {
      "$type": "strokeStyle",
      "$value": {
        "dashArray": [
          "14px",
          "8px"
        ],
        "lineCap": "butt"
      },
      "$description": "Alinhavo: linhas de movimento."
    },
    "pesponto": {
      "$type": "strokeStyle",
      "$value": {
        "dashArray": [
          "3px",
          "3px"
        ],
        "lineCap": "butt"
      },
      "$description": "Pesponto: bordas, detalhes."
    }
  },
  "motion": {
    "duration": {
      "instante": {
        "$type": "duration",
        "$value": "120ms",
        "$description": "Feedback de toque e cor."
      },
      "ponto": {
        "$type": "duration",
        "$value": "240ms",
        "$description": "Hover curto, ícones."
      },
      "alinhavo": {
        "$type": "duration",
        "$value": "480ms",
        "$description": "Menu, acordeão, campos."
      },
      "caimento": {
        "$type": "duration",
        "$value": "800ms",
        "$description": "Revelação de texto e imagem."
      },
      "cerimonia": {
        "$type": "duration",
        "$value": "1200ms",
        "$description": "Hero e transição de página."
      },
      "bordado": {
        "$type": "duration",
        "$value": "1800ms",
        "$description": "Desenho de linha longa."
      }
    },
    "easing": {
      "caimento": {
        "$type": "cubicBezier",
        "$value": [
          0.16,
          1,
          0.3,
          1
        ],
        "$description": "Entradas. Cai rápido, assenta devagar."
      },
      "cortina": {
        "$type": "cubicBezier",
        "$value": [
          0.7,
          0,
          0.2,
          1
        ],
        "$description": "Wipes, cortina de tule, página."
      },
      "corte": {
        "$type": "cubicBezier",
        "$value": [
          0.5,
          0,
          0.1,
          1
        ],
        "$description": "Registro Casimira."
      },
      "linha": {
        "$type": "cubicBezier",
        "$value": [
          0.45,
          0.05,
          0.25,
          1
        ],
        "$description": "Strokes e costuras."
      },
      "saida": {
        "$type": "cubicBezier",
        "$value": [
          0.55,
          0,
          1,
          0.45
        ],
        "$description": "Saídas."
      },
      "balanco": {
        "$type": "string",
        "$value": "linear(0, .34 8%, .86 17%, 1.05 26%, 1.03 34%, .995 46%, 1)",
        "$description": "Mola leve: cabide que balança. Fallback: caimento."
      }
    },
    "delay": {
      "stagger-letra": {
        "$type": "duration",
        "$value": "18ms"
      },
      "stagger-linha": {
        "$type": "duration",
        "$value": "80ms"
      },
      "stagger-peca": {
        "$type": "duration",
        "$value": "120ms"
      },
      "respiro": {
        "$type": "duration",
        "$value": "200ms",
        "$description": "Intervalo entre camadas hierárquicas."
      }
    },
    "ratio": {
      "exit": {
        "$type": "number",
        "$value": 0.6,
        "$description": "Saída = 60% da duração da entrada."
      },
      "casimira": {
        "$type": "number",
        "$value": 0.85,
        "$description": "Registro Casimira: durações de caimento x0.85."
      }
    }
  }
}