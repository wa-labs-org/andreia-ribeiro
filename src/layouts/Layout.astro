---
// Layout base: carrega o design system de /andreia-ribeiro-design-system
// (fonte da verdade) e os elementos globais: barra de progresso, grão de
// papel, cursor e loader.
import '../../andreia-ribeiro-design-system/assets/ar.css';
import '../styles/site.css';
import '../styles/fonts.css';
/* fontes da hero, pré-carregadas para a primeira pintura não esperar o CSS */
import cormorant300 from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-300-normal.woff2?url';
import cormorant300i from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-300-italic.woff2?url';
import jost300 from '@fontsource/jost/files/jost-latin-300-normal.woff2?url';
import Loader from '../components/Loader.astro';
import { contato } from '../data/contato';

interface Props {
	title?: string;
	description?: string;
	/** imagem de compartilhamento (caminho em /public), 1200 × 630 */
	image?: string;
	imageAlt?: string;
}

const {
	title = 'Andréia Ribeiro Atelier · Aluguel de vestidos em Loanda – PR',
	description = 'Aluguel de vestidos de noiva, madrinha, debutante, formatura e gala em Loanda – PR. Provas com hora marcada e ajustes sob medida, feitos à mão no ateliê.',
	image = '/og.jpg',
	imageAlt = 'Andréia Ribeiro Atelier — noiva em vestido de renda com mangas longas, sobre o fundo marfim do ateliê.',
} = Astro.props;

/* SEO: endereço canônico e URLs absolutas a partir de `site` (astro.config.mjs) */
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;
const nome = 'Andréia Ribeiro Atelier';

/* dados estruturados (schema.org) do ateliê como negócio local */
const tel = contato.whatsapp ? `+${contato.whatsapp.slice(0, 2)} ${contato.whatsapp.slice(2, 4)} ${contato.whatsapp.slice(4, 9)}-${contato.whatsapp.slice(9)}` : undefined;
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'ClothingStore',
	'@id': `${site.href.replace(/\/$/, '')}/#atelie`,
	name: nome,
	description,
	url: site.href,
	image: ogImage,
	telephone: tel,
	address: {
		'@type': 'PostalAddress',
		streetAddress: contato.enderecoPartes.rua,
		addressLocality: contato.enderecoPartes.cidade,
		addressRegion: contato.enderecoPartes.estado,
		postalCode: contato.enderecoPartes.cep,
		addressCountry: contato.enderecoPartes.pais,
	},
	hasMap: contato.mapa,
	areaServed: { '@type': 'City', name: `${contato.enderecoPartes.cidade} – ${contato.enderecoPartes.estado}` },
	sameAs: [contato.instagram, contato.pinterest].filter(Boolean),
};
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#FFFDF8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<!-- compartilhamento (WhatsApp, Instagram, Facebook, LinkedIn…) -->
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:site_name" content={nome} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={imageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={imageAlt} />

		<!-- dados estruturados: o ateliê como negócio local -->
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<link rel="preload" href={cormorant300} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={cormorant300i} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={jost300} as="font" type="font/woff2" crossorigin />
	</head>
	<body>
		<div class="progress" id="progress"></div>
		<div class="grain"></div>
		<div class="cursor" id="cursor"><i></i><b></b></div>
		<Loader />
		<slot />

		<script>
			import { gsap, ScrollTrigger, lenis, reduceMotion, finePointer } from '../scripts/motion.js';

			const progressEl = document.getElementById('progress')!;
			const headerEl = document.getElementById('site-header');

			/* inclinação leve das seções conforme a velocidade da rolagem (ØDE) */
			const SKEW_MAX = 1.6;
			const SKEW_FACTOR = 0.1;
			gsap.utils.toArray<HTMLElement>('.section .wrap').forEach((w) => w.classList.add('skewable'));
			const setSkew = reduceMotion || !document.querySelector('.skewable')
				? null
				: gsap.quickTo('.skewable', 'skewY', { duration: 0.8, ease: 'power3.out' });
			const clampSkew = gsap.utils.clamp(-SKEW_MAX, SKEW_MAX);

			lenis.on('scroll', (e: { progress: number; scroll: number; velocity: number }) => {
				progressEl.style.transform = `scaleX(${e.progress || 0})`;
				headerEl?.classList.toggle('is-scrolled', (e.scroll || 0) > 40);
				if (setSkew) setSkew(clampSkew((e.velocity || 0) * SKEW_FACTOR));
			});

			/* âncoras da página deslizam com o Lenis */
			document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) =>
				a.addEventListener('click', (e) => {
					const href = a.getAttribute('href')!;
					const target = href.length > 1 ? document.querySelector<HTMLElement>(href) : null;
					if (!target) return;
					e.preventDefault();
					lenis.scrollTo(target, {
						offset: href === '#top' ? 0 : -(headerEl?.offsetHeight || 70),
						duration: 1.6,
						easing: (t) => 1 - Math.pow(1 - t, 3),
						immediate: reduceMotion,
					});
				}),
			);

			/* cursor próprio: anel dourado */
			const cur = document.getElementById('cursor')!;
			if (finePointer) {
				document.body.style.cursor = 'none';
				const xTo = gsap.quickTo(cur, 'x', { duration: 0.2, ease: 'power3.out' });
				const yTo = gsap.quickTo(cur, 'y', { duration: 0.2, ease: 'power3.out' });
				/* sobre áreas escuras (café) o cursor vira dourado-claro: o anel padrão usa
				   mix-blend multiply e some no escuro. Marque outras áreas com data-cursor-escuro. */
				const ESCURO = '.section-dark, .mmenu, .fabric--cafe, [data-cursor-escuro]';
				let px = -1;
				let py = -1;
				const atualizarTom = (alvo: Element | null) =>
					cur.classList.toggle('is-dark', !!alvo?.closest(ESCURO));
				window.addEventListener('mousemove', (e) => {
					px = e.clientX;
					py = e.clientY;
					xTo(px);
					yTo(py);
					atualizarTom(e.target as Element);
				});
				/* a página pode rolar por baixo do mouse parado */
				lenis.on('scroll', () => {
					if (px >= 0) atualizarTom(document.elementFromPoint(px, py));
				});
				document.querySelectorAll<HTMLElement>('a, button, input, select, textarea, label').forEach((el) => {
					el.style.cursor = 'none';
					el.addEventListener('mouseenter', () => cur.classList.add('is-link'));
					el.addEventListener('mouseleave', () => cur.classList.remove('is-link'));
				});
			} else cur.style.display = 'none';

			window.addEventListener('load', () => ScrollTrigger.refresh());
		</script>
	</body>
</html>
