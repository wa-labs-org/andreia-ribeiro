---
// Hero: atmosfera de iridescência em cetim (WebGL2, paleta da seda), a tipografia conduz.
// Intro: o lótus do loader se desenha com o contador, o loader sobe, as letras
// do título sobem uma a uma e o lótus da hero se desenha junto.
---

<section class="hero" id="top">
	<div class="hero-bg" id="hero-iridescence"></div>
	<div class="hero-veil"></div>
	<div class="rules" aria-hidden="true"><i></i><i></i><i></i></div>
	<div class="hero-inner">
		<span class="hero-mark hero-sub" data-lotus></span>
		<p class="eyebrow hero-sub">
			<span class="t-caps">Ateliê sob medida</span><span class="t-mono">— locação de trajes</span>
		</p>
		<h1 class="t-display-xl">
			<span class="sr-only">Sob medida para sua ocasião.</span>
			<span class="hero-line" aria-hidden="true">Sob medida</span>{' '}
			<span class="hero-line is-italic" aria-hidden="true">para sua ocasião.</span>
		</h1>
		<div class="hero-foot hero-sub">
			<p class="t-body-l">
				Vestidos de noiva, de festa e trajes de gala para locar — provados com calma e ajustados à mão no ateliê até vestirem
				como se tivessem sido feitos para você.
			</p>
			<div class="hero-ctas">
				<a href="#colecoes" class="btn btn-gold">Ver o acervo <ar-icon name="arrow-right"></ar-icon></a>
				<a href="#contato" class="link">Agendar prova</a>
			</div>
			<a href="#maison" class="t-mono hero-scroll">
				Role <span class="arrow-round"><ar-icon name="arrow-down"></ar-icon></span> 001
			</a>
		</div>
	</div>
</section>

<style>
	/* A hero ocupa exatamente a altura da tela (nunca mais que isso).
	   Espaços, lótus e título encolhem com a altura (svh) além da largura. */
	.hero {
		position: relative;
		height: 100svh;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		overflow: hidden;
	}
	.hero-bg {
		position: absolute;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		/* base nas cores do tecido, enquanto o WebGL não começa (ou se não houver WebGL) */
		background:
			radial-gradient(120% 80% at 70% 20%, rgba(198, 175, 108, 0.18), transparent 60%),
			linear-gradient(160deg, #fffdf8 0%, #fdf7e7 55%, #fffdf8 100%);
	}
	.hero-veil {
		position: absolute;
		inset: 0;
		z-index: 1;
		background: linear-gradient(
			180deg,
			rgba(255, 253, 248, 0.55) 0%,
			rgba(255, 253, 248, 0) 35%,
			rgba(255, 253, 248, 0.2) 60%,
			var(--bg) 100%
		);
	}
	.hero-inner {
		position: relative;
		z-index: 2;
		/* o topo nunca fica sob o header fixo (5.25rem) */
		padding: clamp(5.75rem, 14svh, 8rem) var(--gutter) clamp(1.25rem, min(5vw, 5svh), 4rem);
	}
	.hero-mark {
		display: block;
		width: clamp(40px, min(7vw, 9svh), 92px);
		aspect-ratio: 1;
		margin-bottom: clamp(0.75rem, min(3vw, 3svh), 2.5rem);
	}
	.eyebrow {
		margin: 0;
	}
	h1 {
		margin: clamp(0.75rem, min(2.5vw, 2.5svh), 2rem) 0 0;
		font-size: min(var(--t-display-xl), 16svh, 17vw);
	}
	.hero-line {
		display: block;
	}
	.hero-line.is-italic {
		font-style: italic;
		color: var(--ouro-texto);
		padding-left: clamp(2rem, 11vw, 12rem);
	}
	.hero-foot {
		margin-top: clamp(1rem, min(4vw, 4svh), 3.5rem);
		padding-top: clamp(1rem, 2.5svh, 1.75rem);
		border-top: 1px solid var(--line);
		display: grid;
		grid-template-columns: minmax(0, 30rem) 1fr auto;
		gap: clamp(1rem, 3svh, 2rem) 2rem;
		align-items: end;
	}
	.hero-foot .t-body-l {
		margin: 0;
	}
	.hero-ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 1.75rem;
		align-items: center;
		justify-content: center;
	}
	.hero-scroll {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.hero-scroll .arrow-round {
		width: 2rem;
		height: 2rem;
	}
	@media (max-width: 860px) {
		.hero-foot {
			grid-template-columns: 1fr;
		}
		.hero-ctas {
			justify-content: flex-start;
		}
	}
	/* celular: texto de apoio um pouco menor */
	@media (max-width: 600px) {
		.hero-foot .t-body-l {
			font-size: 1rem;
			line-height: 1.6;
		}
	}
	/* telas baixas: o indicador "Role" sai (a rolagem é óbvia) */
	@media (max-height: 760px) and (max-width: 860px), (max-height: 600px) {
		.hero-scroll {
			display: none;
		}
	}
	/* telas baixas: o lótus grande sai (a marca continua no header) */
	@media (max-height: 620px) {
		.hero-mark {
			display: none;
		}
	}
	/* celular deitado e telas muito baixas: texto e botões lado a lado */
	@media (max-height: 500px) {
		h1 {
			font-size: min(var(--t-display-xl), 14svh, 17vw);
		}
		.hero-foot {
			grid-template-columns: minmax(0, 1fr) auto;
			align-items: center;
		}
		.hero-foot .t-body-l {
			font-size: 0.9rem;
			line-height: 1.5;
		}
		.hero-ctas {
			flex-direction: column;
			align-items: flex-end;
			gap: 0.75rem;
		}
	}
</style>

<script>
	import { gsap, ScrollTrigger, SplitText, lenis, reduceMotion, CONFIG } from '../scripts/motion.js';
	import { createIridescence } from '../scripts/iridescence.js';

	/* iridescência em cetim: mesmo desenho do componente original, cores da seda */
	/* desempenho: o tecido (WebGL) é criado só depois do carregamento completo da página,
	   para não disputar a thread principal com a primeira pintura (o LCP é o título, pintado
	   no primeiro quadro, por baixo do loader). O loader cobre a hero por ~2,5 s, então o
	   tecido já está pronto quando ela aparece; até lá fica o degradê do CSS (.hero-bg).
	   Meia resolução (é um degradê suave, a diferença não aparece) e, em telas de toque,
	   30 quadros por segundo com teto de DPR 1,5. */
	const toque = window.matchMedia('(pointer: coarse)').matches;
	const depoisDoCarregamento = (fn: () => void) => {
		const agendar = () => ('requestIdleCallback' in window ? (window as any).requestIdleCallback(fn, { timeout: 600 }) : setTimeout(fn, 100));
		if (document.readyState === 'complete') agendar();
		else window.addEventListener('load', agendar, { once: true });
	};
	depoisDoCarregamento(() => createIridescence(document.getElementById('hero-iridescence')!, {
		resolution: 0.5,
		maxDpr: toque ? 1.5 : 2,
		fps: toque ? 30 : 60,
		colors: ['#FFFDF8', '#FDF7E7', '#C6AF6C', '#B19F6E'], // marfim-claro (fundo), marfim, ouro-claro, ouro-antigo
		satin: 0.4,
		shadow: 0.1,
		speed: 1,
		scale: 1.4,
		detail: 8,
		warp: 1,
		rotation: 0,
		mouseReact: true,
		amplitude: 0.1,
		stir: 0.5,
		sheen: 0.3,
		clickSwirl: true,
	}));

	/* loader → hero */
	const counter = { v: 0 };
	const counterEl = document.getElementById('counter')!;
	const loader = document.getElementById('loader')!;
	gsap.set('.lp', { strokeDasharray: 100, strokeDashoffset: 0 });
	if (!reduceMotion) {
		lenis.stop();
		document.body.style.overflow = 'hidden';
	}

	/* saída da hero, ligada à rolagem (e reversível), só com movimento: o título se abre
	   como uma cortina ("Sob medida" para a esquerda, "para sua ocasião." para a direita),
	   o lótus sobe girando, o rótulo corre para a esquerda e a faixa de baixo sobe mais
	   rápido que a página; o tecido amplia e desce (paralaxe) e as linhas recolhem.
	   Criada só depois da entrada, para as duas não disputarem os mesmos elementos. */
	const criarSaida = () => {
		gsap
			.timeline({
				defaults: { ease: 'none' },
				scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: true },
			})
			.to('.hero-mark', { y: -160, rotate: -60, duration: 0.6 }, 0)
			.to('.hero .eyebrow', { x: -220, duration: 0.6 }, 0.05)
			.to('.hero h1 .hero-line:not(.is-italic)', { xPercent: -22, y: -40, duration: 0.8 }, 0.1)
			.to('.hero h1 .hero-line.is-italic', { xPercent: 22, y: -40, duration: 0.8 }, 0.1)
			.to('.hero-foot', { y: -180, duration: 0.8 }, 0.2)
			.to('.hero-bg', { scale: 1.15, yPercent: 20, duration: 1 }, 0)
			.to('.hero .rules i', { scaleY: 0, transformOrigin: '50% 0%', duration: 0.8 }, 0.1);
	};

	/* a abertura espera as fontes do título (a divisão em letras precisa das medidas finais)
	   e é preparada dois quadros depois: assim a primeira pintura — que já mostra o título,
	   o LCP, por baixo do loader — não divide a thread principal com esse trabalho */
	const fontesDoTitulo = Promise.all([
		document.fonts.load('300 1em "Cormorant Garamond"'),
		document.fonts.load('italic 300 1em "Cormorant Garamond"'),
	]).catch(() => undefined);
	const depoisDoPrimeiroQuadro = () => new Promise<void>((ok) => requestAnimationFrame(() => requestAnimationFrame(() => ok())));
	Promise.all([fontesDoTitulo, depoisDoPrimeiroQuadro()]).then(() => {
		/* palavras + letras: as letras animam, mas a quebra de linha respeita a palavra */
		const split = new SplitText('.hero-line', { type: 'words,chars', wordsClass: 'word', charsClass: 'char', aria: 'none' });
		gsap.set('.hero-line', { overflow: 'hidden', paddingBottom: '.08em', paddingRight: '.12em' });
		const done = () => {
			document.body.style.overflow = '';
			lenis.start();
			(window as any).__arIntroDone = true;
			if (!reduceMotion) criarSaida();
			ScrollTrigger.refresh();
		};
		if (reduceMotion) {
			loader.style.display = 'none';
			done();
			return;
		}
		gsap.set('#loader .lp, .hero-mark .lp', { strokeDashoffset: 100 });
		gsap.set('#loader .lp-core, .hero-mark .lp-core', { fillOpacity: 0 });
		gsap
			.timeline({ defaults: { ease: CONFIG.ease }, onComplete: done })
			.to(counter, {
				v: 100,
				duration: CONFIG.loaderDuration,
				ease: 'power2.inOut',
				onUpdate: () => (counterEl.textContent = String(Math.round(counter.v)).padStart(3, '0')),
			}, 0)
			.to('#loader .lp-outer', { strokeDashoffset: 0, duration: 1.1, stagger: 0.07, ease: 'power2.inOut' }, 0)
			.to('#loader .lp-mid', { strokeDashoffset: 0, duration: 1, stagger: 0.06, ease: 'power2.inOut' }, 0.45)
			.to('#loader .lp-inner', { strokeDashoffset: 0, duration: 0.9, stagger: 0.05, ease: 'power2.inOut' }, 0.8)
			.to('#loader .lp-core, #loader .lp-core-inner', { strokeDashoffset: 0, fillOpacity: 1, duration: 0.8 }, 1.4)
			.fromTo('#loader [data-lotus]', { rotate: -22.5, scale: 0.9 }, { rotate: 0, scale: 1, duration: CONFIG.loaderDuration, ease: 'power2.inOut' }, 0)
			.to('#loader', { yPercent: -100, duration: 1, ease: 'power3.inOut' }, '+=0.2')
			.from(split.chars, { yPercent: 115, duration: 1.15, stagger: 0.03 }, '-=0.5')
			.to('.hero-mark .lp', { strokeDashoffset: 0, duration: 1.2, stagger: 0.015, ease: 'power2.inOut' }, '<')
			.to('.hero-mark .lp-core', { fillOpacity: 1, duration: 0.6 }, '<+0.8')
			.from('.hero-sub', { y: 24, autoAlpha: 0, duration: 1, stagger: 0.12 }, '<');
		/* o lótus da hero continua respirando, devagar */
		gsap.to('.hero-mark .lotus-svg', { scale: 1.06, duration: 4, ease: 'sine.inOut', yoyo: true, repeat: -1 });
	});
</script>
