---
// Hero (docs/06-componentes.md · Hero; coreografia em docs/07-motion.md · Partitura do hero).
// Mobile: título → imagem 4:5 → eyebrow → lead → CTAs.
// Desktop: título (col. 1–8) sobre a imagem 3:4 (col. 8–12), alinhavo atravessando, fio do tecido.
import noiva from '../../atelier-design-system/assets/images/figurinos/noiva.svg';
---

<section class="at-hero" data-intro data-cursor-thread aria-labelledby="hero-title">
	<svg
		class="at-hero__thread at-thread"
		data-stitch
		viewBox="0 0 1440 900"
		preserveAspectRatio="none"
		aria-hidden="true"
		style="inset:0;width:100%;height:100%;--at-delay:700ms"
	>
		<path class="at-thread__seam" d="M-20 700C300 780 560 560 860 640S1220 820 1460 700"></path>
	</svg>

	<div class="at-container">
		<div class="at-grid at-hero__grid">
			<h1 class="at-hero__title at-display-xl" id="hero-title" data-reveal="linhas" style="--at-delay:150ms">
				<span class="at-line"><span>A peça certa</span></span>
				<span class="at-line"><span><em>começa</em> na</span></span>
				<span class="at-line"><span>primeira prova.</span></span>
			</h1>

			<div class="at-hero__media">
				<div class="at-photo" data-reveal="tule">
					<div class="at-photo__inner" data-parallax="0.08">
						<img
							class="at-photo__fig"
							src={noiva.src}
							width={noiva.width}
							height={noiva.height}
							fetchpriority="high"
							alt="Croqui de vestido de noiva evasê com cauda, sobre manequim. No site final: fotografia da prova, luz natural lateral."
						/>
					</div>
					<span class="at-photo__caption at-note">Foto 01 · prova final · luz da janela</span>
				</div>
			</div>

			<div class="at-hero__aside">
				<p class="at-eyebrow at-label" data-reveal="fade" style="--at-delay:500ms">
					Atelier de trajes festivos · sob medida e ajustes
				</p>
				<p class="at-lead at-measure-narrow" data-reveal="linhas" style="--at-delay:600ms">
					Vestidos de noiva e madrinha, trajes de noivo e padrinho, cortados e ajustados no seu corpo, <em>prova a prova</em>.
				</p>
				<div class="at-hero__actions" data-reveal="fade" style="--at-delay:850ms">
					<a class="at-btn" href="#agendar" data-magnet>
						<svg class="at-btn__botao" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-botao"></use></svg>
						<span data-roll>Agendar prova</span>
					</a>
					<a class="at-btn at-btn--linha" href="#colecoes">
						<span>Ver coleções</span>
						<svg class="at-icon at-icon--s at-btn__seta" aria-hidden="true"><use href="#i-seta"></use></svg>
					</a>
				</div>
			</div>
		</div>
	</div>

	<div class="at-hero__cue at-grain" aria-hidden="true">
		<span class="at-note">Fio do tecido</span><span class="at-grain__line"></span>
	</div>
</section>
