---
// Maison (segunda dobra): a filosofia do ateliê em duas linhas alternadas,
// imagem 4:5 + texto, com "Atelier" vazado ao fundo.
// Linhas com `galeria` mostram um monte de fotos em leque (arrastar manda a de cima
// para o fim); com `foto`, uma fotografia; sem nenhuma, o painel de tecido com
// croqui marca o lugar da foto real. Fotos otimizadas pelo Astro em AVIF/WebP.
import { Picture } from 'astro:assets';
import noivaRenda from '../assets/maison/noiva-renda.jpg';
import noivaFrente from '../assets/maison/noiva-frente.jpg';
import noivaCostas from '../assets/maison/noiva-costas.jpg';
import noivaCostasPerfil from '../assets/maison/noiva-costas-perfil.jpg';
import noivaCorpete from '../assets/maison/noiva-corpete.jpg';

const linhas = [
	{
		indice: '01',
		rotulo: 'O ateliê',
		titulo: 'Feito à mão,',
		destaque: 'ajustado a você.',
		textos: [
			'Cada traje do acervo passa pelas mãos do ateliê antes de chegar até você. Bainhas, cinturas e alças são ajustadas em provas com hora marcada, sem pressa.',
			'A locação é sob medida; o atendimento também.',
		],
		galeria: [
			{
				src: noivaRenda,
				alt: 'Noiva em vestido de renda branca com mangas longas, decote em V recortado, faixa de cetim na cintura e saia ampla, posando em estúdio.',
				posicao: '50% 85%',
			},
			{
				src: noivaFrente,
				alt: 'Noiva de frente, com a mão no ombro, mostrando o corpete de renda e a saia ampla do vestido.',
				posicao: '50% 80%',
			},
			{
				src: noivaCostas,
				alt: 'Noiva de costas, olhando por cima do ombro, mostrando as costas em renda e o volume da saia.',
				posicao: '50% 75%',
			},
			{
				src: noivaCostasPerfil,
				alt: 'Detalhe das costas e das mangas de renda do vestido, com a noiva de perfil e o cabelo preso.',
				posicao: '50% 30%',
			},
			{
				src: noivaCorpete,
				alt: 'Detalhe do corpete de renda, das mangas longas e da faixa de cetim na cintura.',
				posicao: '50% 30%',
			},
		],
		assinatura: true,
	},
	{
		indice: '02',
		rotulo: 'O cuidado',
		titulo: 'Cada peça',
		destaque: 'volta a brilhar.',
		textos: [
			'Depois de cada noite, o traje retorna ao ateliê: higienização profissional, revisão de costuras, pedrarias e rendas — e só então volta à arara, pronto para a próxima história.',
		],
		tecido: 'rose',
		croqui: 'princesa',
		vaga: 'Foto · detalhe de bordado · 4:5',
		assinatura: false,
	},
];
---

<section class="section maison" id="maison" aria-labelledby="maison-title">
	<div class="maison-ghost t-outline" aria-hidden="true">Atelier</div>
	<div class="wrap">
		{
			linhas.map((l, i) => (
				<div class:list={['maison-row', { rev: i % 2 === 1 }]}>
					{l.galeria ? (
						<div class="maison-media maison-stack-slot">
							<div
								class="stack"
								data-stack
								tabindex="0"
								role="group"
								aria-roledescription="galeria"
								aria-label={`Fotos do vestido, ${l.galeria.length} imagens. Arraste a foto de cima ou use Enter para ver a próxima.`}
							>
								{l.galeria.map((f, k) => (
									<div class="stack-card" aria-hidden={k === 0 ? undefined : 'true'}>
										<div class="stack-card-face">
											<div class="stack-card-content">
												<Picture
													src={f.src}
													alt={f.alt}
													formats={['avif', 'webp']}
													width={960}
													widths={[480, 720, 960, 1280]}
													sizes="(max-width: 860px) calc(86vw - 3rem), 38vw"
													class="maison-foto"
													style={`object-position: ${f.posicao}`}
													draggable="false"
												/>
											</div>
											<div class="stack-card-shade" />
										</div>
									</div>
								))}
							</div>
							<p class="t-mono stack-hint">
								<span>Arraste para o lado</span>
								<span aria-live="polite">
									<b data-stack-now>01</b> / {String(l.galeria.length).padStart(2, '0')}
								</span>
							</p>
						</div>
					) : (
					<div class="maison-media reveal-wrap">
						<div class="reveal-inner">
							{l.foto ? (
								<Picture
									src={l.foto.src}
									alt={l.foto.alt}
									formats={['avif', 'webp']}
									width={960}
									widths={[480, 720, 960, 1280]}
									sizes="(max-width: 860px) calc(100vw - 3rem), 44vw"
									class="maison-foto"
									style={`object-position: ${l.foto.posicao}`}
								/>
							) : (
								<div class={`fabric fabric--${l.tecido}`}>
									<span data-croqui={l.croqui} />
									<span class="slot-tag">{l.vaga}</span>
								</div>
							)}
						</div>
					</div>
					)}
					<div class="maison-copy">
						<p class="eyebrow">
							<span class="t-caps">{l.rotulo}</span>
							<span class="t-mono">{l.indice}</span>
						</p>
						<h2 class="t-display-l" id={i === 0 ? 'maison-title' : undefined}>
							{l.titulo}
							<br />
							<span class="t-italic">{l.destaque}</span>
						</h2>
						{l.textos.map((t) => <p class="t-body-l">{t}</p>)}
						{l.assinatura && (
							<div class="maison-sign">
								<span data-lotus />
								Andréia Ribeiro
							</div>
						)}
					</div>
				</div>
			))
		}
	</div>
</section>

<style>
	.maison {
		overflow: hidden;
	}
	.maison-ghost {
		position: absolute;
		top: 4rem;
		left: 0;
		right: 0;
		text-align: center;
		font-family: var(--f-display);
		font-weight: 300;
		font-size: 17vw;
		line-height: 0.8;
		white-space: nowrap;
		pointer-events: none;
		opacity: 0.55;
	}
	.maison-row {
		position: relative;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(2rem, 7vw, 8rem);
		align-items: center;
	}
	.maison-row + .maison-row {
		margin-top: clamp(5rem, 12vw, 10rem);
	}
	.maison-row.rev .maison-media {
		order: 2;
	}
	.maison-media {
		aspect-ratio: 4 / 5;
		border-radius: var(--radius-media);
		/* mantém os cantos arredondados mesmo com a imagem em escala/paralaxe dentro */
		isolation: isolate;
		overflow: hidden;
	}
	.maison-media .fabric {
		height: 100%;
	}
	.maison-media :global(picture) {
		display: block;
		height: 100%;
	}
	/* a foto 2:3 preenche a moldura 4:5; o enquadramento fica no vestido inteiro */
	.maison-media :global(.maison-foto) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	/* ── monte de fotos em leque ── */
	.maison-stack-slot {
		position: relative;
		overflow: visible;
		border-radius: 0;
		isolation: auto;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
	}
	/* as cartas de trás se abrem para cima e para a direita: o monte ocupa 86% da vaga */
	.stack {
		position: relative;
		width: 86%;
		aspect-ratio: 4 / 5;
		outline: none;
		touch-action: pan-y;
	}
	.stack:focus-visible .stack-card[data-top] .stack-card-face {
		outline: 1px solid var(--ouro);
		outline-offset: 6px;
	}
	.stack-card {
		position: absolute;
		inset: 0;
		will-change: transform;
		user-select: none;
		-webkit-user-select: none;
		-webkit-tap-highlight-color: transparent;
	}
	.stack-card-face {
		position: absolute;
		inset: 0;
		overflow: hidden;
		isolation: isolate;
		border-radius: var(--radius-media);
		box-shadow:
			0 14px 34px -10px rgba(61, 50, 38, 0.45),
			0 3px 8px -2px rgba(61, 50, 38, 0.18);
		will-change: transform;
	}
	.stack-card-content {
		position: relative;
		width: 100%;
		height: 100%;
		overflow: hidden;
		border-radius: inherit;
	}
	.stack-card-content :global(picture) {
		display: block;
		height: 100%;
	}
	.stack-card-content :global(img) {
		pointer-events: none;
		-webkit-user-drag: none;
	}
	.stack-card-shade {
		position: absolute;
		inset: 0;
		background: var(--cafe);
		border-radius: inherit;
		pointer-events: none;
		opacity: 0;
	}
	.stack-hint {
		display: flex;
		justify-content: space-between;
		width: 86%;
		margin: 1.25rem 0 0;
	}
	.stack-hint b {
		font-weight: 400;
		color: var(--ink);
	}

	.maison-copy {
		max-width: 32rem;
	}
	.eyebrow {
		margin: 0;
	}
	.maison-copy h2 {
		margin: 1.75rem 0;
	}
	.maison-copy .t-body-l {
		margin: 0;
	}
	.maison-copy .t-body-l + .t-body-l {
		margin-top: 1.1rem;
	}
	.maison-sign {
		margin-top: 2.5rem;
		display: flex;
		align-items: center;
		gap: 1rem;
		font-family: var(--f-display);
		font-style: italic;
		font-size: 1.6rem;
		color: var(--bronze);
	}
	.maison-sign [data-lotus] {
		width: 30px;
		height: 30px;
	}
	@media (max-width: 860px) {
		.maison-row {
			grid-template-columns: 1fr;
		}
		.maison-row.rev .maison-media {
			order: 0;
		}
	}
</style>

<script>
	import { gsap, ScrollTrigger, reduceMotion, CONFIG } from '../scripts/motion.js';
	import { createStack } from '../scripts/stack.js';

	/* monte de fotos em leque: abre quando entra na tela */
	document.querySelectorAll<HTMLElement>('.maison [data-stack]').forEach((root) => {
		const now = root.parentElement?.querySelector('[data-stack-now]');
		const stack = createStack(root, {
			layout: 'fan',
			visible: 4,
			spread: 0.5,
			depth: 0.5,
			tilt: 30,
			threshold: 90,
			speed: 1,
			sendToBackOnClick: false,
			onChange: (top: number) => {
				if (now) now.textContent = String(top + 1).padStart(2, '0');
			},
		});
		ScrollTrigger.create({ trigger: root, start: 'top 80%', once: true, onEnter: () => stack.start() });
	});

	if (!reduceMotion) {
		/* imagens: a cortina sobe (clip-path), a imagem assenta e o croqui se desenha */
		document.querySelectorAll<HTMLElement>('.maison .reveal-wrap').forEach((wrap) => {
			const inner = wrap.querySelector('.reveal-inner');
			gsap
				.timeline({ defaults: { ease: CONFIG.ease, duration: 1.3 }, scrollTrigger: { trigger: wrap, start: 'top 80%' } })
				.to(wrap, { clipPath: 'inset(0% 0 0 0)' })
				.to(inner, { scale: 1.04 }, 0)
				.fromTo(
					wrap.querySelectorAll('[data-croqui] path'),
					{ strokeDasharray: 100, strokeDashoffset: 100 },
					{ strokeDashoffset: 0, duration: 2.2, stagger: 0.06, ease: 'power2.inOut' },
					0.3,
				);
			/* paralaxe leve dentro da moldura */
			gsap.to(inner, {
				yPercent: -5,
				ease: 'none',
				scrollTrigger: { trigger: wrap, start: 'top bottom', end: 'bottom top', scrub: true },
			});
		});

		/* "Atelier" desce e esmaece com a rolagem */
		gsap.to('.maison-ghost', {
			yPercent: 30,
			opacity: 0.2,
			ease: 'none',
			scrollTrigger: { trigger: '#maison', start: 'top bottom', end: 'bottom top', scrub: true },
		});

		/* textos sobem ao entrar */
		gsap.utils.toArray<HTMLElement>('.maison-copy').forEach((el) =>
			gsap.from(el.children, {
				y: 36,
				autoAlpha: 0,
				duration: 1.1,
				stagger: 0.1,
				ease: CONFIG.ease,
				scrollTrigger: { trigger: el, start: 'top 82%' },
			}),
		);
	}
</script>
