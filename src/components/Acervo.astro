---
// Acervo em destaque: carrossel líquido (FlexCarousel, ver scripts/flexcarousel.js).
// As fotos correm numa fila infinita curvada por uma lente em WebGL2 (preset
// "liquid", entrada "rise"). Arrastar, rolar a página ou usar as setas move a
// fila; clicar centraliza a foto e, no segundo clique, amplia, mostrando o
// convite para a prova. Sem WebGL2, uma fila simples com rolagem lateral.
// Nomes e referências são de exemplo e precisam ser confirmados com o ateliê.
import { getImage, Picture } from 'astro:assets';
import noivaRenda from '../assets/maison/noiva-renda.jpg';
import noivaFrente from '../assets/maison/noiva-frente.jpg';
import noivaCostas from '../assets/maison/noiva-costas.jpg';
import noivaCostasPerfil from '../assets/maison/noiva-costas-perfil.jpg';
import noivaCorpete from '../assets/maison/noiva-corpete.jpg';
import bordadoFolhasAzul from '../assets/maison/bordado-folhas-azul.jpg';
import galaAzul from '../assets/colecoes/gala-azul.jpg';
import galaAzulBordado from '../assets/acervo/gala-azul-bordado.jpg';
import bordadoJacquardRosa from '../assets/maison/bordado-jacquard-rosa.jpg';
import debutanteRosa from '../assets/colecoes/debutante-rosa.jpg';
import debutanteRosaPerfil from '../assets/acervo/debutante-rosa-perfil.jpg';
import bordadoCorpeteDourado from '../assets/maison/bordado-corpete-dourado.jpg';
import bordadoCapaDourada from '../assets/maison/bordado-capa-dourada.jpg';
import formaturaDourado from '../assets/colecoes/formatura-dourado.jpg';
import formaturaDouradoCapa from '../assets/acervo/formatura-dourado-capa.jpg';

const pecas = [
	{ nome: 'Vestido Aurora', detalhe: 'Noiva · renda e cetim' },
	{ nome: 'Vestido Celeste', detalhe: 'Gala · cetim bordado' },
	{ nome: 'Vestido Camélia', detalhe: 'Debutante · jacquard' },
	{ nome: 'Vestido Âmbar', detalhe: 'Formatura · tule e capa' },
];

/* `peca` aponta para a lista acima; a ordem alterna as cores na fila */
const fontes: { src: ImageMetadata; peca: number; alt: string }[] = [
	{ src: noivaRenda, peca: 0, alt: 'Noiva em vestido de renda com mangas longas e saia ampla.' },
	{ src: bordadoFolhasAzul, peca: 1, alt: 'Corpete azul bordado com ramos de folhas em pedraria.' },
	{ src: debutanteRosa, peca: 2, alt: 'Vestido rosa em jacquard metalizado com saia em camadas.' },
	{ src: bordadoCorpeteDourado, peca: 3, alt: 'Corpete dourado coberto de linhas de pedraria.' },
	{ src: noivaCostas, peca: 0, alt: 'Noiva de costas mostrando as costas em renda e o volume da saia.' },
	{ src: galaAzul, peca: 1, alt: 'Vestido azul de cetim com decote assimétrico e saia ampla.' },
	{ src: formaturaDouradoCapa, peca: 3, alt: 'Vestido dourado com capa de tule e gola alta.' },
	{ src: bordadoJacquardRosa, peca: 2, alt: 'Corpete rosa em jacquard metalizado com rosas em relevo.' },
	{ src: noivaCorpete, peca: 0, alt: 'Detalhe do corpete de renda e da faixa de cetim do vestido de noiva.' },
	{ src: galaAzulBordado, peca: 1, alt: 'Vestido azul bordado, com a mão na cintura, em estúdio.' },
	{ src: debutanteRosaPerfil, peca: 2, alt: 'Vestido rosa em jacquard visto de perfil, saia em camadas.' },
	{ src: formaturaDourado, peca: 3, alt: 'Vestido dourado tomara que caia com fenda, coberto de pedrarias.' },
	{ src: noivaFrente, peca: 0, alt: 'Noiva de frente com a mão no ombro, corpete de renda e saia ampla.' },
	{ src: bordadoCapaDourada, peca: 3, alt: 'Detalhe da capa de tule dourado bordada com pedrarias.' },
	{ src: noivaCostasPerfil, peca: 0, alt: 'Costas e mangas de renda do vestido de noiva, de perfil.' },
];

/* texturas do WebGL: uma versão de 900px de cada foto (nítida no zoom em telas 2x) */
const itens = await Promise.all(
	fontes.map(async (f) => ({
		src: (await getImage({ src: f.src, width: 900, format: 'webp' })).src,
		alt: f.alt,
		title: pecas[f.peca].nome,
		subtitle: pecas[f.peca].detalhe,
	})),
);
const total = String(itens.length).padStart(2, '0');
---

<section class="section section-alt acervo" id="acervo" aria-labelledby="acervo-title">
	<div class="wrap">
		<div class="head-row">
			<div>
				<p class="eyebrow"><span class="t-caps">Em destaque</span><span class="t-mono">Temporada 2026/27</span></p>
				<h2 class="t-display-l" id="acervo-title">Peças que <span class="t-italic">pedem prova.</span></h2>
			</div>
			<a href="#colecoes" class="btn btn-breathing">Ver todo o acervo <ar-icon name="arrow-right"></ar-icon></a>
		</div>
	</div>

	<div
		class="flex-carousel"
		data-flex-carousel
		data-items={JSON.stringify(itens)}
		role="region"
		aria-roledescription="carrossel"
		aria-label="Fotos das peças em destaque. Use as setas para navegar e Enter para ampliar."
		tabindex="0"
		style="--flex-carousel-half: 25%"
	>
		<div class="fc-caption" hidden>
			<p class="fc-title">
				<span class="piece-name" data-fc-name></span>
				<span class="t-mono fc-sub" data-fc-sub></span>
			</p>
			<p class="fc-count t-mono" data-fc-count>
				<span class="fc-digits">
					{
						[0, 1].map(() => (
							<span class="fc-digit">
								<span class="fc-reel" data-fc-reel>
									{'0123456789'.split('').map((n) => <span>{n}</span>)}
								</span>
							</span>
						))
					}
				</span>
				<span class="fc-slash">/</span>
				<span>{total}</span>
			</p>
			<a href="#contato" class="btn btn-gold btn-sm fc-cta" data-fc-cta tabindex="-1">
				Agendar prova <ar-icon name="arrow-right"></ar-icon>
			</a>
		</div>
		<p class="sr-only" aria-live="polite" aria-atomic="true" data-fc-live></p>

		<!-- sem WebGL2: fila simples com rolagem lateral -->
		<ul class="fc-fallback" role="list">
			{
				fontes.map((f) => (
					<li>
						<Picture src={f.src} alt={f.alt} formats={['avif', 'webp']} width={480} widths={[320, 480]} sizes="240px" loading="lazy" />
						<span class="t-mono">{pecas[f.peca].nome}</span>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.acervo {
		overflow: hidden;
	}

	.flex-carousel {
		position: relative;
		width: 100%;
		height: clamp(560px, 78vh, 760px);
		overflow: hidden;
		cursor: grab;
		touch-action: pan-y;
		user-select: none;
		-webkit-user-select: none;
		-webkit-tap-highlight-color: transparent;
		overscroll-behavior: contain;
		outline: none;
	}
	.flex-carousel[data-hover='open'] {
		cursor: zoom-in;
	}
	.flex-carousel[data-hover='close'] {
		cursor: zoom-out;
	}
	.flex-carousel[data-dragging] {
		cursor: grabbing;
	}
	/* com o cursor próprio do site, o do sistema some (o anel cresce no hover) */
	@media (hover: hover) and (pointer: fine) {
		.flex-carousel,
		.flex-carousel[data-hover],
		.flex-carousel[data-dragging] {
			cursor: none;
		}
	}
	.flex-carousel:focus-visible {
		box-shadow: inset 0 0 0 2px var(--accent);
	}

	/* ── legenda ────────────────────────────────────────────── */
	.fc-caption {
		position: absolute;
		left: 0;
		right: 0;
		top: calc(50% + var(--flex-carousel-half) * var(--flex-carousel-lift, 1) + 1.4rem);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6rem;
		padding: 0 16px;
		pointer-events: none;
		text-align: center;
		animation: fc-reveal 900ms ease both;
	}
	.fc-caption[hidden] {
		display: none;
	}
	.fc-title {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.35rem;
		margin: 0;
	}
	.fc-title:global(.is-in) {
		animation: fc-title 520ms cubic-bezier(0.22, 1, 0.36, 1);
	}
	.fc-title .piece-name {
		font-size: clamp(1.4rem, 2vw, 1.8rem);
	}
	.fc-sub {
		color: var(--ink-soft);
	}
	.fc-count {
		display: inline-flex;
		align-items: center;
		gap: 3px;
		margin: 0;
		line-height: 1;
		font-variant-numeric: tabular-nums;
		color: var(--ink-mute);
		transition: opacity 400ms ease;
	}
	.flex-carousel:global([data-focus-open]) .fc-count {
		opacity: 0;
	}
	.fc-digits {
		display: inline-flex;
	}
	.fc-digit {
		display: inline-block;
		height: 1em;
		overflow: hidden;
	}
	.fc-reel {
		display: flex;
		flex-direction: column;
		transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
	}
	.fc-reel span {
		height: 1em;
	}
	.fc-slash {
		opacity: 0.6;
	}
	/* o convite para a prova aparece com a foto ampliada */
	.fc-cta {
		opacity: 0;
		transform: translateY(8px);
		pointer-events: none;
		transition:
			opacity 0.4s ease,
			transform 0.5s var(--ease-out);
	}
	.flex-carousel:global([data-focus-open]) .fc-cta {
		opacity: 1;
		transform: none;
		pointer-events: auto;
		transition-delay: 0.15s;
	}

	/* ── sem WebGL2 ─────────────────────────────────────────── */
	.fc-fallback {
		display: none;
	}
	.flex-carousel:global(.no-gl) {
		height: auto;
		cursor: auto;
	}
	.flex-carousel:global(.no-gl) .fc-fallback {
		display: flex;
		gap: 12px;
		margin: 0;
		padding: 0 var(--gutter) 1rem;
		list-style: none;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
	}
	.fc-fallback li {
		flex: 0 0 auto;
		width: min(240px, 60vw);
		scroll-snap-align: center;
		display: grid;
		gap: 0.6rem;
	}
	.fc-fallback :global(img) {
		width: 100%;
		aspect-ratio: 2 / 3;
		object-fit: cover;
		border-radius: var(--radius-media);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	@keyframes fc-title {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
	@keyframes fc-reveal {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.fc-caption,
		.fc-title:global(.is-in) {
			animation: none;
		}
		.fc-reel {
			transition: none;
		}
	}
</style>

<script>
	import { gsap, lenis, reduceMotion, CONFIG } from '../scripts/motion.js';
	import { createFlexCarousel } from '../scripts/flexcarousel.js';

	type Item = { src: string; alt: string; title: string; subtitle: string };
	const root = document.querySelector<HTMLElement>('.acervo [data-flex-carousel]');

	if (root) {
		const items: Item[] = JSON.parse(root.dataset.items || '[]');
		const caption = root.querySelector<HTMLElement>('.fc-caption')!;
		const title = root.querySelector<HTMLElement>('.fc-title')!;
		const name = root.querySelector<HTMLElement>('[data-fc-name]')!;
		const sub = root.querySelector<HTMLElement>('[data-fc-sub]')!;
		const reels = [...root.querySelectorAll<HTMLElement>('[data-fc-reel]')];
		const live = root.querySelector<HTMLElement>('[data-fc-live]')!;
		const cta = root.querySelector<HTMLAnchorElement>('[data-fc-cta]')!;
		const cursor = document.getElementById('cursor');

		const show = (i: number) => {
			const it = items[i];
			if (!it) return;
			name.textContent = it.title;
			sub.textContent = it.subtitle;
			title.classList.remove('is-in');
			void title.offsetWidth; // reinicia a animação do título
			title.classList.add('is-in');
			String(i + 1)
				.padStart(2, '0')
				.split('')
				.forEach((d, k) => (reels[k].style.transform = `translateY(${-Number(d) * 10}%)`));
			live.textContent = `${it.title}, ${i + 1} de ${items.length}`;
		};

		/* o botão da prova não deve virar arraste nem fechar a foto */
		['pointerdown', 'pointerup'].forEach((t) => cta.addEventListener(t, (e) => e.stopPropagation()));

		const carousel = createFlexCarousel(
			root,
			items,
			{
				preset: 'liquid',
				intro: 'rise',
				cardHeight: 0.5,
				gap: 12,
				squeeze: 0.2,
				focusOnClick: true,
				fit: 'natural',
				radius: 18, // cantos suaves como as outras fotos do site
				captureWheel: false, // a roda vertical continua rolando a página
			},
			{
				onChange: show,
				onReveal: () => (caption.hidden = false),
				onFocusChange: (open: boolean) => {
					root.toggleAttribute('data-focus-open', open);
					cta.tabIndex = open ? 0 : -1;
				},
				onHover: (h: string) => cursor?.classList.toggle('is-link', !!h),
			},
		);

		if (!carousel) {
			root.classList.add('no-gl');
			root.removeAttribute('tabindex');
		} else if (!reduceMotion) {
			/* rolar a página empurra a fila, só enquanto o carrossel está na tela */
			const PX_POR_PX = 0.8;
			let naTela = false;
			let ultimo = lenis.scroll;
			new IntersectionObserver(([e]) => (naTela = e.isIntersecting)).observe(root);
			lenis.on('scroll', (e: { scroll: number }) => {
				const delta = e.scroll - ultimo;
				ultimo = e.scroll;
				if (naTela && delta) carousel.nudge(delta * PX_POR_PX);
			});
		}

		if (!reduceMotion) {
			gsap.from('.acervo .head-row > *', {
				y: 36,
				autoAlpha: 0,
				duration: 1.1,
				stagger: 0.1,
				ease: CONFIG.ease,
				scrollTrigger: { trigger: '.acervo .head-row', start: 'top 82%' },
			});
		}
	}
</script>
