---
// Acervo em destaque: quatro peças em cards 3:4 (as pares descem um degrau),
// com nome, ocasião e tecido, e um selo de disponibilidade. A foto sobe numa
// cortina (clip-path) ao entrar na tela e cresce de leve no hover.
// Nomes, referências e disponibilidade são de exemplo e precisam ser
// confirmados com o ateliê.
import { Picture } from 'astro:assets';
import noivaFrente from '../assets/maison/noiva-frente.jpg';
import galaAzulBordado from '../assets/acervo/gala-azul-bordado.jpg';
import debutanteRosaPerfil from '../assets/acervo/debutante-rosa-perfil.jpg';
import formaturaDouradoCapa from '../assets/acervo/formatura-dourado-capa.jpg';

type Status = 'ok' | 'few' | 'off';
const selo: Record<Status, string> = { ok: 'Disponível', few: 'Poucas datas', off: 'Reservado' };

const pecas: {
	tipo: string;
	nome: string;
	detalhe: string;
	ref: string;
	status: Status;
	foto: ImageMetadata;
	posicao: string;
	alt: string;
}[] = [
	{
		tipo: 'Vestido',
		nome: 'Aurora',
		detalhe: 'Noiva · renda e cetim',
		ref: 'AR-001',
		status: 'ok',
		foto: noivaFrente,
		posicao: '50% 78%',
		alt: 'Noiva de frente em vestido de renda branca com mangas longas e saia ampla.',
	},
	{
		tipo: 'Vestido',
		nome: 'Celeste',
		detalhe: 'Gala · cetim bordado',
		ref: 'AR-014',
		status: 'few',
		foto: galaAzulBordado,
		posicao: '50% 72%',
		alt: 'Vestido azul de cetim com decote assimétrico e ramos de folhas bordados em pedraria.',
	},
	{
		tipo: 'Vestido',
		nome: 'Camélia',
		detalhe: 'Debutante · jacquard',
		ref: 'AR-027',
		status: 'ok',
		foto: debutanteRosaPerfil,
		posicao: '50% 68%',
		alt: 'Vestido rosa tomara que caia em jacquard metalizado com rosas, saia em camadas, visto de perfil.',
	},
	{
		tipo: 'Vestido',
		nome: 'Âmbar',
		detalhe: 'Formatura · tule e capa',
		ref: 'AR-040',
		status: 'off',
		foto: formaturaDouradoCapa,
		posicao: '50% 48%',
		alt: 'Vestido dourado coberto de pedrarias com capa de tule e gola alta.',
	},
];
---

<section class="section section-alt acervo" id="acervo" aria-labelledby="acervo-title">
	<div class="wrap">
		<div class="head-row">
			<div>
				<p class="eyebrow"><span class="t-caps">Em destaque</span><span class="t-mono">Temporada 2026/27</span></p>
				<h2 class="t-display-l" id="acervo-title">Peças que <span class="t-italic">pedem prova.</span></h2>
			</div>
			<a href="#colecoes" class="btn btn-breathing">Ver todo o acervo <ar-icon name="arrow-right"></ar-icon></a>
		</div>
		<ul class="pieces" role="list">
			{
				pecas.map((p) => (
					<li>
						<a href="#provas" class="piece" aria-label={`${p.tipo} ${p.nome}, ${p.detalhe}. ${selo[p.status]}. Agendar prova.`}>
							<div class="piece-media reveal-wrap">
								<div class="reveal-inner">
									<Picture
										src={p.foto}
										alt={p.alt}
										formats={['avif', 'webp']}
										width={720}
										widths={[360, 540, 720, 960]}
										sizes="(max-width: 960px) calc(50vw - 2.5rem), 22vw"
										loading="lazy"
										class="piece-foto"
										style={`object-position: ${p.posicao}`}
									/>
								</div>
								<span class="piece-ref t-mono">Ref. {p.ref}</span>
							</div>
							<div class="piece-body">
								<div>
									<p class="piece-name">
										{p.tipo} <em>{p.nome}</em>
									</p>
									<p class="t-mono piece-detail">{p.detalhe}</p>
								</div>
								<span class={`badge badge-${p.status}`}>{selo[p.status]}</span>
							</div>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.pieces {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: clamp(1rem, 2vw, 2rem);
	}
	/* as peças pares descem um degrau, como no design system */
	.pieces > li:nth-child(even) {
		margin-top: 4rem;
	}
	@media (max-width: 960px) {
		.pieces {
			grid-template-columns: 1fr 1fr;
			row-gap: 2.5rem;
		}
		.pieces > li:nth-child(even) {
			margin-top: 2.5rem;
		}
	}

	.piece-media {
		position: relative;
	}
	.piece-foto {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 1.2s var(--ease-out);
	}
	.piece:hover .piece-foto {
		transform: scale(1.04);
	}
	.piece-ref {
		position: absolute;
		left: 0.9rem;
		bottom: 0.8rem;
		padding: 0.3rem 0.6rem;
		border-radius: var(--radius-pill);
		background: rgba(255, 253, 248, 0.78);
		backdrop-filter: blur(6px);
		color: var(--ink-soft);
		font-size: 0.6rem;
	}
	.piece-name {
		margin: 0;
	}
	.piece:hover .piece-name em {
		color: var(--bronze);
	}
	.piece-detail {
		margin: 0.4rem 0 0;
	}
	.piece-body {
		flex-wrap: wrap;
		align-items: flex-start;
	}
	.piece:focus-visible {
		outline: 1px solid var(--accent);
		outline-offset: 6px;
		border-radius: var(--radius-media);
	}
	@media (max-width: 560px) {
		.piece-name {
			font-size: 1.3rem;
		}
	}
</style>

<script>
	import { gsap, reduceMotion, CONFIG } from '../scripts/motion.js';

	if (!reduceMotion && document.querySelector('.acervo')) {
		gsap.from('.acervo .head-row > *', {
			y: 36,
			autoAlpha: 0,
			duration: 1.1,
			stagger: 0.1,
			ease: CONFIG.ease,
			scrollTrigger: { trigger: '.acervo .head-row', start: 'top 82%' },
		});

		/* cada foto sobe numa cortina e assenta, com um pequeno atraso entre os cards */
		document.querySelectorAll<HTMLElement>('.acervo .reveal-wrap').forEach((wrap, i) => {
			gsap
				.timeline({
					delay: (i % 4) * 0.08,
					defaults: { ease: CONFIG.ease, duration: 1.3 },
					scrollTrigger: { trigger: wrap, start: 'top 85%' },
				})
				.to(wrap, { clipPath: 'inset(0% 0 0 0)' })
				.fromTo(wrap.querySelector('.reveal-inner'), { scale: 1.15 }, { scale: 1 }, 0);
		});

		gsap.from('.acervo .piece-body', {
			y: 18,
			autoAlpha: 0,
			duration: 0.9,
			stagger: 0.08,
			ease: CONFIG.ease,
			scrollTrigger: { trigger: '.acervo .pieces', start: 'top 75%' },
		});
	}
</script>
