---
// Acervo em destaque: cúpula de fotos (DomeGallery, ver scripts/domegallery.js).
// As fotos forram o lado de dentro de uma esfera que gira ao arrastar, só na
// horizontal e também acompanha a rolagem da página. Ao passar o cursor a foto
// ganha cor aos poucos e cresce; ao clicar, ela amplia com nome, ocasião,
// disponibilidade e o convite para a prova.
// Nomes, referências e disponibilidade são de exemplo e precisam ser
// confirmados com o ateliê.
import { getImage } from 'astro:assets';
import noivaRenda from '../assets/maison/noiva-renda.jpg';
import noivaFrente from '../assets/maison/noiva-frente.jpg';
import noivaCostas from '../assets/maison/noiva-costas.jpg';
import noivaCostasPerfil from '../assets/maison/noiva-costas-perfil.jpg';
import noivaCorpete from '../assets/maison/noiva-corpete.jpg';
import bordadoFolhasAzul from '../assets/maison/bordado-folhas-azul.jpg';
import galaAzul from '../assets/colecoes/gala-azul.jpg';
import galaAzulBordado from '../assets/acervo/gala-azul-bordado.jpg';
import bordadoJacquardRosa from '../assets/maison/bordado-jacquard-rosa.jpg';
import debutanteRosa from '../assets/colecoes/debutante-rosa.jpg';
import debutanteRosaPerfil from '../assets/acervo/debutante-rosa-perfil.jpg';
import bordadoCorpeteDourado from '../assets/maison/bordado-corpete-dourado.jpg';
import bordadoCapaDourada from '../assets/maison/bordado-capa-dourada.jpg';
import formaturaDourado from '../assets/colecoes/formatura-dourado.jpg';
import formaturaDouradoCapa from '../assets/acervo/formatura-dourado-capa.jpg';

type Status = 'ok' | 'few' | 'off';
const selo: Record<Status, string> = { ok: 'Disponível', few: 'Poucas datas', off: 'Reservado' };

const pecas: { tipo: string; nome: string; detalhe: string; ref: string; status: Status }[] = [
	{ tipo: 'Vestido', nome: 'Aurora', detalhe: 'Noiva · renda e cetim', ref: 'AR-001', status: 'ok' },
	{ tipo: 'Vestido', nome: 'Celeste', detalhe: 'Gala · cetim bordado', ref: 'AR-014', status: 'few' },
	{ tipo: 'Vestido', nome: 'Camélia', detalhe: 'Debutante · jacquard', ref: 'AR-027', status: 'ok' },
	{ tipo: 'Vestido', nome: 'Âmbar', detalhe: 'Formatura · tule e capa', ref: 'AR-040', status: 'off' },
];

/* `peca` aponta para a lista acima; a ordem alterna as cores na cúpula */
const fontes: { src: ImageMetadata; peca: number; alt: string; posicao?: string }[] = [
	{ src: noivaRenda, peca: 0, alt: 'Noiva em vestido de renda com mangas longas e saia ampla.', posicao: '50% 80%' },
	{ src: bordadoFolhasAzul, peca: 1, alt: 'Corpete azul bordado com ramos de folhas em pedraria.' },
	{ src: debutanteRosa, peca: 2, alt: 'Vestido rosa em jacquard metalizado com saia em camadas.', posicao: '50% 62%' },
	{ src: bordadoCorpeteDourado, peca: 3, alt: 'Corpete dourado coberto de linhas de pedraria.', posicao: '50% 45%' },
	{ src: noivaCostas, peca: 0, alt: 'Noiva de costas mostrando as costas em renda e o volume da saia.', posicao: '50% 75%' },
	{ src: galaAzul, peca: 1, alt: 'Vestido azul de cetim com decote assimétrico e saia ampla.', posicao: '50% 55%' },
	{ src: formaturaDouradoCapa, peca: 3, alt: 'Vestido dourado com capa de tule e gola alta.', posicao: '50% 45%' },
	{ src: bordadoJacquardRosa, peca: 2, alt: 'Corpete rosa em jacquard metalizado com rosas em relevo.', posicao: '50% 65%' },
	{ src: noivaCorpete, peca: 0, alt: 'Detalhe do corpete de renda e da faixa de cetim do vestido de noiva.', posicao: '50% 30%' },
	{ src: galaAzulBordado, peca: 1, alt: 'Vestido azul bordado, com a mão na cintura, em estúdio.', posicao: '50% 65%' },
	{ src: debutanteRosaPerfil, peca: 2, alt: 'Vestido rosa em jacquard visto de perfil, saia em camadas.', posicao: '50% 55%' },
	{ src: formaturaDourado, peca: 3, alt: 'Vestido dourado tomara que caia com fenda, coberto de pedrarias.', posicao: '50% 55%' },
	{ src: noivaFrente, peca: 0, alt: 'Noiva de frente com a mão no ombro, corpete de renda e saia ampla.', posicao: '50% 70%' },
	{ src: bordadoCapaDourada, peca: 3, alt: 'Detalhe da capa de tule dourado bordada com pedrarias.' },
	{ src: noivaCostasPerfil, peca: 0, alt: 'Costas e mangas de renda do vestido de noiva, de perfil.', posicao: '50% 35%' },
];

const fotos = await Promise.all(
	fontes.map(async (f) => ({
		...f,
		thumb: (await getImage({ src: f.src, width: 640, format: 'webp' })).src,
		large: (await getImage({ src: f.src, width: 1200, format: 'webp' })).src,
	})),
);

/* grade da cúpula (como no original): colunas de 2 em 2 unidades e linhas
   intercaladas; as fotos se repetem sem duas iguais lado a lado */
const SEGMENTOS = 34;
const coords = Array.from({ length: SEGMENTOS }, (_, c) => -37 + c * 2).flatMap((x, c) =>
	(c % 2 === 0 ? [-4, -2, 0, 2, 4] : [-3, -1, 1, 3, 5]).map((y) => ({ x, y })),
);
const vistas = new Set<number>();
const itens = coords.map((c, i) => {
	const foto = (i * 7) % fotos.length; // passo 7 (primo com 15) espalha as repetições
	const focavel = !vistas.has(foto);
	vistas.add(foto);
	return { ...c, foto, focavel };
});
---

<section class="section section-alt acervo" id="acervo" aria-labelledby="acervo-title">
	<div class="wrap">
		<div class="head-row">
			<div>
				<p class="eyebrow"><span class="t-caps">Em destaque</span><span class="t-mono">Temporada 2026/27</span></p>
				<h2 class="t-display-l" id="acervo-title">Peças que <span class="t-italic">pedem prova.</span></h2>
			</div>
			<a href="#colecoes" class="btn btn-breathing">Ver todo o acervo <ar-icon name="arrow-right"></ar-icon></a>
		</div>
	</div>

	<div class="dg-root" data-dome style={`--segments: ${SEGMENTOS}`}>
		<div class="dg-main" role="group" aria-label="Fotos das peças em destaque. Arraste para girar; Enter amplia a foto.">
			<div class="dg-stage">
				<div class="dg-sphere">
					{
						itens.map((it) => {
							const f = fotos[it.foto];
							const p = pecas[f.peca];
							return (
								<div class="dg-item" data-x={it.x} data-y={it.y} style={`--offset-x: ${it.x}; --offset-y: ${it.y}`}>
									<button
										type="button"
										class="dg-tile"
										data-item={f.peca}
										data-photo={it.foto}
										data-large={f.large}
										tabindex={it.focavel ? undefined : '-1'}
										aria-hidden={it.focavel ? undefined : 'true'}
										aria-label={it.focavel ? `Ampliar: ${p.tipo} ${p.nome}, ${p.detalhe}` : undefined}
									>
										<img
											src={f.thumb}
											alt={f.alt}
											loading="lazy"
											decoding="async"
											draggable="false"
											style={f.posicao ? `object-position: ${f.posicao}` : undefined}
										/>
									</button>
								</div>
							);
						})
					}
				</div>
			</div>
			<div class="dg-overlay" aria-hidden="true"></div>
			<div class="dg-overlay dg-overlay--blur" aria-hidden="true"></div>
			<div class="dg-edge dg-edge--top" aria-hidden="true"></div>
			<div class="dg-edge dg-edge--bottom" aria-hidden="true"></div>
		</div>

		<div class="dg-viewer" role="dialog" aria-modal="true" aria-labelledby="dg-card-title">
			<div class="dg-scrim"></div>
			<figure class="dg-card">
				<div class="dg-card-media"><img alt="" /></div>
				<figcaption class="dg-card-cap">
					{
						pecas.map((p, i) => (
							<div class="dg-card-info" data-card={i} hidden>
								<p class="eyebrow">
									<span class="t-caps">{p.detalhe.split(' · ')[0]}</span>
									<span class="t-mono">Ref. {p.ref}</span>
								</p>
								<p class="piece-name" id={i === 0 ? 'dg-card-title' : undefined} data-card-title>
									{p.tipo} <em>{p.nome}</em>
								</p>
								<p class="t-mono dg-meta">{p.detalhe.split(' · ')[1]}</p>
								<span class={`badge badge-${p.status}`}>{selo[p.status]}</span>
							</div>
						))
					}
					<div class="dg-card-actions">
						<a href="#provas" class="btn btn-gold btn-sm" data-dg-cta>
							Agendar prova <ar-icon name="arrow-right"></ar-icon>
						</a>
						<button type="button" class="dg-close t-mono" data-dg-close>Fechar</button>
					</div>
				</figcaption>
			</figure>
		</div>
	</div>
</section>

<style>
	.acervo {
		overflow: hidden;
	}

	/* ── cúpula (geometria do original) ─────────────────────── */
	.dg-root {
		--radius: 600px;
		--circ: calc(var(--radius) * 3.14);
		--rot-y: calc((360deg / var(--segments)) / 2);
		--rot-x: calc((360deg / var(--segments)) / 2);
		--item-width: calc(var(--circ) / var(--segments));
		--item-height: calc(var(--circ) / var(--segments));
		--tile-radius: clamp(0.9rem, 1.6vw, 1.5rem);
		--dg-bg: var(--bg-alt);
		position: relative;
		width: 100%;
		height: clamp(560px, 92vh, 940px);
	}
	.dg-main {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		overflow: hidden;
		touch-action: pan-y; /* só gira na horizontal: a rolagem vertical continua da página */
		user-select: none;
		-webkit-user-select: none;
		cursor: grab;
	}
	.dg-root:global(.is-dragging) .dg-main {
		cursor: grabbing;
	}
	.dg-stage {
		width: 100%;
		height: 100%;
		display: grid;
		place-items: center;
		perspective: calc(var(--radius) * 2);
		perspective-origin: 50% 50%;
		contain: layout paint size;
	}
	.dg-sphere,
	.dg-item,
	.dg-tile {
		transform-style: preserve-3d;
	}
	.dg-sphere {
		transform: translateZ(calc(var(--radius) * -1));
		will-change: transform;
	}
	.dg-item {
		position: absolute;
		inset: -999px;
		margin: auto;
		width: calc(var(--item-width) * 2);
		height: calc(var(--item-height) * 2);
		transform-origin: 50% 50%;
		backface-visibility: hidden;
		transform: rotateY(calc(var(--rot-y) * (var(--offset-x) + 0.5))) rotateX(calc(var(--rot-x) * (var(--offset-y) - 0.5)))
			translateZ(var(--radius));
	}
	.dg-tile {
		position: absolute;
		inset: 10px;
		display: block;
		padding: 0;
		border: 0;
		border-radius: var(--tile-radius);
		background: var(--manteiga);
		overflow: hidden;
		backface-visibility: hidden;
		transform: translateZ(0) scale(1);
		cursor: inherit;
		-webkit-tap-highlight-color: transparent;
		touch-action: manipulation;
		transition:
			transform 0.9s var(--ease-out),
			box-shadow 0.9s var(--ease-out);
	}
	.dg-tile img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		pointer-events: none;
		backface-visibility: hidden;
		/* as duas pontas usam as mesmas funções de filtro: assim a cor entra aos
		   poucos (de "none" o navegador não interpola e a troca fica seca) */
		filter: grayscale(1) saturate(0.9) contrast(0.95) brightness(1.02);
		transform: scale(1.04);
		transition:
			filter 1.1s var(--ease-out),
			transform 1.4s var(--ease-out);
	}
	/* hover: a foto ganha cor devagar, cresce e se aproxima um pouco */
	@media (hover: hover) {
		.dg-tile:hover {
			transform: translateZ(28px) scale(1.08);
			box-shadow: var(--shadow-lift);
		}
		.dg-tile:hover img {
			filter: grayscale(0) saturate(1.05) contrast(1) brightness(1);
			transform: scale(1);
		}
	}
	.dg-tile:focus-visible {
		outline: none;
		transform: translateZ(28px) scale(1.08);
		box-shadow:
			var(--shadow-lift),
			inset 0 0 0 2px var(--accent);
	}
	.dg-tile:focus-visible img {
		filter: grayscale(0) saturate(1.05) contrast(1) brightness(1);
		transform: scale(1);
	}
	.dg-root:global(.is-dragging) .dg-tile {
		transition-duration: 0.4s;
	}

	/* véus: a cúpula se dissolve no fundo da seção */
	.dg-overlay {
		position: absolute;
		inset: 0;
		z-index: 3;
		pointer-events: none;
		background-image: radial-gradient(transparent 65%, var(--dg-bg) 100%);
	}
	.dg-overlay--blur {
		background: none;
		-webkit-mask-image: radial-gradient(transparent 70%, #000 90%);
		mask-image: radial-gradient(transparent 70%, #000 90%);
		backdrop-filter: blur(3px);
	}
	.dg-edge {
		position: absolute;
		left: 0;
		right: 0;
		height: 120px;
		z-index: 5;
		pointer-events: none;
		background: linear-gradient(to bottom, transparent, var(--dg-bg));
	}
	.dg-edge--top {
		top: 0;
		transform: rotate(180deg);
	}
	.dg-edge--bottom {
		bottom: 0;
	}

	.dg-meta {
		margin: 0;
		color: var(--ink-soft);
	}

	/* ── foto ampliada ──────────────────────────────────────── */
	.dg-viewer {
		position: fixed;
		inset: 0;
		z-index: 90;
		display: none;
		align-items: center;
		justify-content: center;
		padding: clamp(1rem, 4vw, 3rem);
	}
	.dg-root:global([data-open]) .dg-viewer {
		display: flex;
	}
	.dg-scrim {
		position: absolute;
		inset: 0;
		background: rgba(61, 50, 38, 0.42);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		opacity: 0;
		transition: opacity 0.5s ease;
	}
	.dg-card {
		position: relative;
		z-index: 1;
		margin: 0;
		display: flex;
		align-items: stretch;
		gap: clamp(1rem, 3vw, 2.5rem);
		max-width: 100%;
	}
	.dg-card-media {
		height: min(78vh, 720px);
		aspect-ratio: 3 / 4;
		border-radius: var(--radius-media);
		overflow: hidden;
		box-shadow: var(--shadow-lift);
		background: var(--manteiga);
		transform-origin: top left;
		will-change: transform;
	}
	.dg-card-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.dg-card-cap {
		align-self: flex-end;
		width: min(20rem, 30vw);
		padding: 1.5rem;
		border-radius: var(--radius-media);
		background: var(--bg);
		box-shadow: var(--shadow-lift);
		opacity: 0;
		transform: translateY(14px);
		transition:
			opacity 0.45s ease,
			transform 0.6s var(--ease-out);
	}
	.dg-root:global([data-shown]) .dg-scrim {
		opacity: 1;
	}
	.dg-root:global([data-shown]) .dg-card-cap {
		opacity: 1;
		transform: none;
		transition-delay: 0.18s;
	}
	.dg-card-info .eyebrow {
		margin: 0 0 0.9rem;
	}
	.dg-card-info .piece-name {
		margin: 0;
		font-size: clamp(1.8rem, 2.6vw, 2.3rem);
	}
	.dg-card-info .dg-meta {
		margin: 0.5rem 0 1rem;
	}
	.dg-card-actions {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		margin-top: 1.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--line);
	}
	.dg-close {
		padding: 0.3rem 0;
		border: 0;
		background: none;
		color: var(--ink-soft);
		text-transform: uppercase;
		letter-spacing: 0.2em;
	}
	.dg-close:hover,
	.dg-close:focus-visible {
		color: var(--bronze);
	}
	@media (max-width: 760px) {
		.dg-card {
			flex-direction: column;
			align-items: center;
		}
		.dg-card-media {
			height: min(56vh, 520px);
		}
		.dg-card-cap {
			align-self: center;
			width: min(100%, 22rem);
			padding: 1.1rem 1.25rem;
		}
	}
</style>

<script>
	import { gsap, lenis, reduceMotion, CONFIG } from '../scripts/motion.js';
	import { createDomeGallery } from '../scripts/domegallery.js';

	const root = document.querySelector<HTMLElement>('.acervo [data-dome]');

	if (root) {
		const cards = [...root.querySelectorAll<HTMLElement>('.dg-card-info')];
		const cursor = document.getElementById('cursor');

		const dome = createDomeGallery(root, {
			/* sem o teto pela altura, a cúpula ocupa a largura toda (as bordas
			   saem da tela) e as fotos ficam maiores, já que crescem com o raio */
			fit: 0.82,
			heightGuard: Infinity,
			minRadius: 600,
			maxVerticalRotationDeg: 0,
			segments: 34,
			dragDampening: 2,
			reduced: reduceMotion,
			onActive: (item: number | null) => cursor?.classList.toggle('is-link', item !== null),
			onOpen: (tile: HTMLElement) => {
				const item = tile.dataset.item;
				cards.forEach((c) => {
					const on = c.dataset.card === item;
					c.hidden = !on;
					/* o título do diálogo é sempre o da peça aberta */
					const title = c.querySelector<HTMLElement>('[data-card-title]');
					if (title) title.id = on ? 'dg-card-title' : '';
				});
				lenis.stop();
			},
			onClose: () => lenis.start(),
		});

		if (!reduceMotion) {
			/* rolar a página gira a cúpula: cada px rolado vira um pouco de giro,
			   só enquanto a cúpula está na tela */
			const GIRO_POR_PX = 0.06;
			let naTela = false;
			let ultimo = lenis.scroll;
			new IntersectionObserver(([e]) => (naTela = e.isIntersecting)).observe(root);
			lenis.on('scroll', (e: { scroll: number }) => {
				const delta = e.scroll - ultimo;
				ultimo = e.scroll;
				if (naTela && delta) dome.spin(-delta * GIRO_POR_PX);
			});

			gsap.from('.acervo .head-row > *', {
				y: 36,
				autoAlpha: 0,
				duration: 1.1,
				stagger: 0.1,
				ease: CONFIG.ease,
				scrollTrigger: { trigger: '.acervo .head-row', start: 'top 82%' },
			});
			/* só opacidade: um transform aqui prenderia o diálogo (position: fixed) */
			gsap.from('.acervo .dg-main', {
				autoAlpha: 0,
				duration: 1.6,
				ease: CONFIG.ease,
				scrollTrigger: { trigger: root, start: 'top 85%' },
			});
		}
	}
</script>
