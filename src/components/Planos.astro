---
// Locação: os formatos de locação em cards (Soma sticky pricing). A coluna da
// esquerda fica fixa com um índice que acompanha o card visível; os cards têm
// o brilho dourado que segue o mouse (.glow). Diferenças em relação ao design
// system: cantos com --radius-media (como as fotos) e, no card em destaque,
// o selo "Sob medida" no lugar de "Mais escolhido" (afirmação não verificada).
// Formatos, itens e prazos são de exemplo e precisam ser confirmados.
const planos = [
	{
		prefixo: 'Locação',
		nome: 'Essencial',
		resumo: 'Para quem já sabe o que quer vestir.',
		prazo: 'por peça · 4 dias',
		itens: ['Uma prova no ateliê', 'Ajustes de barra e alça', 'Higienização profissional inclusa'],
	},
	{
		prefixo: 'Locação',
		nome: 'Atelier',
		resumo: 'O traje com as suas medidas.',
		prazo: 'por peça · 4 dias',
		itens: ['Até três provas no ateliê', 'Ajustes sob medida, feitos à mão', 'Acessórios do acervo para compor', 'Retirada passada e embalada'],
		destaque: 'Sob medida',
	},
	{
		prefixo: 'Primeira',
		nome: 'Estreia',
		resumo: 'Seja a primeira a vestir uma peça nova.',
		prazo: 'peça inédita · 4 dias',
		itens: ['Peça recém-chegada ao acervo', 'Provas e ajustes ilimitados', 'Atendimento com Andréia Ribeiro'],
	},
];
const n = (i: number) => String(i + 1).padStart(2, '0');
---

<section class="section planos" id="planos" aria-labelledby="planos-title">
	<div class="wrap plans">
		<div class="plans-sticky">
			<p class="eyebrow">
				<span class="t-caps">Locação</span><span class="t-mono">{String(planos.length).padStart(2, '0')} formatos</span>
			</p>
			<h2 class="t-display-l" id="planos-title">Escolha<br /><span class="t-italic">como vestir.</span></h2>
			<p class="t-body-l">
				Todos os formatos incluem higienização profissional e capa para transporte. Os valores variam conforme a peça.
			</p>
			<nav class="plans-nav" aria-label="Formatos de locação">
				{
					planos.map((p, i) => (
						<button type="button" class:list={{ 'is-active': i === 0 }} data-i={i}>
							{n(i)} — {p.nome}
						</button>
					))
				}
			</nav>
		</div>
		<ul class="plans-cards" role="list">
			{
				planos.map((p, i) => (
					<li class:list={['plan', 'glow', { 'plan--featured': p.destaque }]} id={`plano-${i + 1}`}>
						<div class="plan-top">
							<span class="t-mono">{n(i)}</span>
							{p.destaque && <span class="badge badge-gold">{p.destaque}</span>}
						</div>
						<h3 class="plan-name">
							{p.prefixo} <em class="t-italic">{p.nome}</em>
						</h3>
						<p class="t-small plan-resumo">{p.resumo}</p>
						<p class="plan-price">Sob consulta</p>
						<p class="t-mono plan-prazo">{p.prazo}</p>
						<ul class="plan-list">
							{p.itens.map((item) => (
								<li>{item}</li>
							))}
						</ul>
						<a href="#contato" class:list={['btn', p.destaque ? 'btn-gold' : 'btn-breathing']}>
							Reservar <ar-icon name="arrow-right" />
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.plans {
		display: grid;
		grid-template-columns: minmax(0, 24rem) 1fr;
		gap: clamp(2rem, 6vw, 7rem);
	}
	.plans-sticky {
		position: sticky;
		top: 8rem;
		align-self: start;
	}
	.eyebrow {
		margin: 0;
	}
	.plans-sticky h2,
	.plans-sticky .t-body-l {
		margin: 1.5rem 0 0;
	}
	.plans-nav {
		margin-top: 2.75rem;
	}
	.plans-cards {
		display: grid;
		gap: 2rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	/* cantos arredondados como as fotos, em vez dos 2px do design system */
	.plan {
		border-radius: var(--radius-media);
	}
	.plan-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1rem;
	}
	.plan--featured .plan-top .t-mono,
	.plan--featured .plan-prazo {
		color: rgba(253, 247, 231, 0.45);
	}
	.plan--featured .plan-name em {
		color: var(--ouro-claro);
	}
	.plan-resumo {
		margin: 0.6rem 0 0;
	}
	.plan-prazo {
		margin: 0;
	}
	.plan .btn {
		align-self: flex-start;
	}
	@media (max-width: 960px) {
		.plans {
			grid-template-columns: 1fr;
		}
		.plans-sticky {
			position: static;
		}
		/* no celular o índice não precisa acompanhar: os cards vêm logo abaixo */
		.plans-nav {
			display: none;
		}
	}
</style>

<script>
	import { gsap, ScrollTrigger, lenis, reduceMotion, CONFIG } from '../scripts/motion.js';

	const cards = gsap.utils.toArray<HTMLElement>('.planos .plan');
	const nav = Array.from(document.querySelectorAll<HTMLButtonElement>('.planos .plans-nav button'));
	const ativar = (i: number) =>
		nav.forEach((b, j) => {
			b.classList.toggle('is-active', i === j);
			if (i === j) b.setAttribute('aria-current', 'true');
			else b.removeAttribute('aria-current');
		});

	cards.forEach((c, i) => {
		/* cada card sobe e se endireita ao entrar */
		if (!reduceMotion)
			gsap.fromTo(
				c,
				{ y: 80, opacity: 0, rotateX: 5 },
				{ y: 0, opacity: 1, rotateX: 0, duration: 1.2, ease: CONFIG.ease, clearProps: 'transform', scrollTrigger: { trigger: c, start: 'top 88%' } },
			);
		/* o índice fixo marca o card visível */
		ScrollTrigger.create({ trigger: c, start: 'top 55%', end: 'bottom 55%', onEnter: () => ativar(i), onEnterBack: () => ativar(i) });
	});

	/* clicar no índice leva ao card */
	nav.forEach((b, i) =>
		b.addEventListener('click', () => lenis.scrollTo(cards[i], { offset: -140, duration: 1.4, immediate: reduceMotion })),
	);

	/* brilho dourado que segue o mouse */
	cards.forEach((el) =>
		el.addEventListener('mousemove', (e) => {
			const r = el.getBoundingClientRect();
			el.style.setProperty('--x', e.clientX - r.left + 'px');
			el.style.setProperty('--y', e.clientY - r.top + 'px');
		}),
	);
</script>
