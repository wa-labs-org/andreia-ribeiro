---
// Coleções (ØDE catalogue): o acervo listado por ocasião. Cada linha leva ao
// acervo. Sem a prévia que seguia o cursor no design system (removida a pedido).

const colecoes = [
	{ nome: 'Noivas', meta: 'Renda · cauda · véu' },
	{ nome: '<em>Madrinhas</em>', meta: 'Longos · fluidos · cor' },
	{ nome: 'Debutantes', meta: 'Volume · tule · brilho' },
	{ nome: 'Formaturas', meta: 'Coluna · fenda · cetim' },
	{ nome: 'Gala &amp; <em>black tie</em>', meta: 'Sereia · bordado · noite' },
	{ nome: 'Trajes <em>masculinos</em>', meta: 'Smoking · fraque · costume' },
];
const total = String(colecoes.length).padStart(2, '0');
---

<section class="section colecoes" id="colecoes" aria-labelledby="colecoes-title">
	<div class="wrap">
		<div class="head-row">
			<div>
				<p class="eyebrow"><span class="t-caps">Coleções</span><span class="t-mono">{total}</span></p>
				<h2 class="t-display-l" id="colecoes-title">O acervo,<br /><span class="t-italic">por ocasião.</span></h2>
			</div>
			<p class="t-body head-note">
				Cada coleção reúne peças escolhidas para um tipo de ocasião, e todas podem ser ajustadas no ateliê.
			</p>
		</div>
		<ul class="cat-list" role="list">
			{
				colecoes.map((c, i) => (
					<li>
						<a class="cat-row" href="#acervo">
							<span class="cat-no">{String(i + 1).padStart(2, '0')}</span>
							<span class="cat-name" set:html={c.nome} />
							<span class="cat-meta">{c.meta}</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.cat-row:focus-visible {
		outline: 1px solid var(--accent);
		outline-offset: 4px;
	}
</style>

<script>
	import { gsap, reduceMotion } from '../scripts/motion.js';

	const list = document.querySelector<HTMLElement>('.colecoes .cat-list');

	if (list) {
		const rows = gsap.utils.toArray<HTMLElement>('.colecoes .cat-row');

		if (!reduceMotion) {
			gsap.from('.colecoes .head-row > *', {
				y: 36,
				autoAlpha: 0,
				duration: 1.1,
				stagger: 0.1,
				ease: 'power3.out',
				scrollTrigger: { trigger: '.colecoes .head-row', start: 'top 82%' },
			});
			gsap.from(rows, {
				autoAlpha: 0,
				y: 24,
				duration: 0.9,
				stagger: 0.08,
				clearProps: 'opacity,visibility,transform',
				scrollTrigger: { trigger: list, start: 'top 82%' },
			});

			/* saída, ligada à rolagem (e reversível): o topo (título e texto) sobe e esmaece, e
			   cada linha da lista se dissolve ao chegar perto do header. Age no bloco do topo e
			   nos itens <li>, não nos elementos que já têm animação de entrada. */
			gsap.to('.colecoes .head-row', {
				y: -60,
				opacity: 0,
				ease: 'none',
				scrollTrigger: { trigger: '.colecoes .head-row', start: 'top 15%', end: 'bottom top', scrub: true },
			});
			gsap.utils.toArray<HTMLElement>('.colecoes .cat-list > li').forEach((li) =>
				gsap.to(li, {
					y: -30,
					opacity: 0,
					ease: 'none',
					scrollTrigger: { trigger: li, start: 'top 22%', end: 'bottom 8%', scrub: true },
				}),
			);
		}
	}
</script>
