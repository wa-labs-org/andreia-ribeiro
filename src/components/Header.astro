---
// Header + menu em tela cheia (docs/06-componentes.md · Header, Alternador de menu, Menu).
// Os destinos são âncoras das próximas dobras da home.
const colecoes = [
	{ label: 'Noivas', href: '#colecoes' },
	{ label: 'Madrinhas', href: '#colecoes' },
	{ label: 'Noivos', href: '#alfaiataria' },
	{ label: 'Padrinhos', href: '#alfaiataria' },
];
---

<header class="at-header">
	<div class="at-header__inner">
		<div class="at-header__start">
			<nav class="at-header__nav" aria-label="Coleções">
				{colecoes.map((c) => <a class="at-navlink" href={c.href}>{c.label}</a>)}
			</nav>
		</div>
		<a class="at-brand" href="/" aria-label="Andreia Ribeiro Atelier — início">
			<svg class="at-brand__mono" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
				<circle cx="24" cy="24" r="20"></circle>
				<circle cx="24" cy="24" r="15" stroke-dasharray="2.4 2.4"></circle>
				<circle cx="19.5" cy="19.5" r="2"></circle>
				<circle cx="28.5" cy="19.5" r="2"></circle>
				<circle cx="19.5" cy="28.5" r="2"></circle>
				<circle cx="28.5" cy="28.5" r="2"></circle>
				<path d="M20.9 20.9 27.1 27.1M27.1 20.9 20.9 27.1" stroke="#B99847" stroke-width="1.5"></path>
			</svg>
			<span class="at-brand__name"><b>Andreia Ribeiro</b><small>Atelier · sob medida</small></span>
		</a>
		<div class="at-header__end">
			<a class="at-btn at-btn--s at-header__cta" href="#agendar"><span data-roll>Agendar prova</span></a>
			<button class="at-menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="at-menu">
				<span class="at-menu-toggle__label"><span>Menu</span><span aria-hidden="true">Fechar</span></span>
				<span class="at-menu-toggle__icon" aria-hidden="true"><i></i><i></i></span>
			</button>
		</div>
	</div>
</header>

<div class="at-menu" id="at-menu" role="dialog" aria-modal="true" aria-label="Menu">
	<nav class="at-menu__list" aria-label="Principal">
		<div class="at-menu__item"><a class="at-menu__link" href="#colecoes"><span class="at-note">01</span>Noivas</a></div>
		<div class="at-menu__item"><a class="at-menu__link" href="#colecoes"><span class="at-note">02</span>Madrinhas</a></div>
		<div class="at-menu__item"><a class="at-menu__link" href="#alfaiataria"><span class="at-note">03</span>Noivos &amp; <em>padrinhos</em></a></div>
		<div class="at-menu__item"><a class="at-menu__link" href="#processo"><span class="at-note">04</span>Como <em>trabalhamos</em></a></div>
		<div class="at-menu__item"><a class="at-menu__link" href="#agendar"><span class="at-note">05</span>Agendar prova</a></div>
	</nav>
	<div class="at-menu__foot">
		<span class="at-note">Rua das Tecelãs, 120 · sala 3</span>
		<span class="at-note">Ter a sáb · 10h–19h · com hora marcada</span>
	</div>
</div>
